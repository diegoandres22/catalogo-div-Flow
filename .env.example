# Contraseña única del panel de administración (/admin).
ADMIN_PASSWORD=

# Vercel genera esta variable automáticamente al conectar Blob al proyecto
# (Storage -> Create Database -> Blob). No hace falta configurarla a mano en
# producción; en local, copiá el token desde el dashboard de Vercel si querés
# probar contra el store real.
BLOB_READ_WRITE_TOKEN=
